# Copy to app/.env (git-ignored). Generate the token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TOUCHDOWN_WORKER_TOKEN=
# Optional, but recommended for a public link: the page asks for it before anyone can queue a GPU job
TOUCHDOWN_PASSCODE=
# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > the token in the install command
TUNNEL_TOKEN=
